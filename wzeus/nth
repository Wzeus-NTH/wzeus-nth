local neonObjects = {}
local function applyNeonEffect(obj, isText)
    table.insert(neonObjects, {Object = obj, IsText = isText})
end

-- Tối ưu mượt không lag (chạy ~20 lần/giây)
task.spawn(function()
    while true do
        local hue = (tick() * 0.3) % 1
        local neonColor = Color3.fromHSV(hue, 1, 1)

        for _, data in ipairs(neonObjects) do
            if data.Object and data.Object.Parent then
                if data.IsText then
                    data.Object.TextColor3 = neonColor
                else
                    data.Object.Color = Color3.fromHSV(hue, 1, 1)
                end
            end
        end
        task.wait(0.05)
    end
end)

local function createStroke(obj)
    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 2
    stroke.Parent = obj

    local grad = Instance.new("UIGradient")
    grad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
        ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 128, 0)),
        ColorSequenceKeypoint.new(0.4, Color3.fromRGB(255, 255, 0)),
        ColorSequenceKeypoint.new(0.6, Color3.fromRGB(0, 255, 0)),
        ColorSequenceKeypoint.new(0.8, Color3.fromRGB(0, 255, 255)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(128, 0, 255))
    })
    grad.Rotation = 45
    grad.Parent = stroke

    applyNeonEffect(stroke, false)
end

