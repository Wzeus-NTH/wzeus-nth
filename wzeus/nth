local function switchTab(activeBtn, activePage)
    playClickSound()
    NoKeyPage.Visible = false
    GetKeyPage.Visible = false
    ServerPage.Visible = false
    InfoPage.Visible = false

    TabNoKeyBtn.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    TabNoKeyBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
    TabGetKeyBtn.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    TabGetKeyBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
    TabServerBtn.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    TabServerBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
    TabInfoBtn.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    TabInfoBtn.TextColor3 = Color3.fromRGB(180, 180, 180)

    activePage.Visible = true
    activeBtn.BackgroundColor3 = Color3.fromRGB(40, 0, 80)
    activeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
end

TabNoKeyBtn.MouseButton1Click:Connect(function()
